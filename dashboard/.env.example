# Supabase (server-side)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Optional: expose read-only access to the browser (RLS = select only)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional: hand new requests straight to the n8n pipeline after storing them
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/customer-ops-intake
N8N_WEBHOOK_SECRET=change-me-long-random-string
