# ---------------------------------------------------------------------------
# Supabase  (Project Settings -> API)
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# n8n  (host these as environment variables in the n8n instance, or paste
# them into the expressions flagged with $env in the workflow JSON)
# ---------------------------------------------------------------------------
# Credentials (created inside n8n UI -> Credentials, then selected on nodes):
#   - Gmail OAuth2 credential   -> used by "Gmail Trigger" + send nodes
#   - Supabase credential       -> used by every Supabase node
#   - Anthropic API credential  -> used by the "Anthropic Claude" model node
#
# Optional environment variables used by expressions in the workflow:
OPS_TEAM_EMAIL=customer-ops@yourcompany.com
SUPPORT_INBOX=support@yourcompany.com
# When set, the n8n "Webhook Intake" node rejects payloads whose
# x-webhook-secret header does not match (the dashboard always sends it).
N8N_WEBHOOK_SECRET=change-me-long-random-string

# ---------------------------------------------------------------------------
# Dashboard / API
# ---------------------------------------------------------------------------
# URL of the deployed n8n "Webhook Intake" node (optional). When set, the
# dashboard's POST /api/webhook/intake forwards new requests into the
# n8n pipeline after storing them in Supabase.
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/customer-ops-intake
# (keep a server-side secret so only your dashboard can trigger the workflow;
#  must match N8N_WEBHOOK_SECRET above)
# N8N_WEBHOOK_SECRET=change-me-long-random-string
# Optional: when set, write endpoints (POST /api/requests,
# PATCH /api/requests/:id) require the header x-admin-token with this value.
# Leave unset for local demos; set it before exposing the dashboard.
# DASHBOARD_API_TOKEN=another-long-random-string
